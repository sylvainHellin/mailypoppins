---
// Replaces Starlight's Hero on the landing page (the only page with `hero`
// frontmatter): the pitch, three links and the install box, on one screen.
import { Code, Icon, TabItem, Tabs } from '@astrojs/starlight/components';
import StarlightHero from '@astrojs/starlight/components/Hero.astro';

const { entry } = Astro.locals.starlightRoute;
const { data } = entry;
// Only the landing page gets the install box; the 404 page keeps Starlight's.
const isLanding = entry.id === 'index' || entry.id === '';
const title = data.hero?.title ?? data.title;
const tagline = data.hero?.tagline;

const repo = 'https://github.com/sylvainHellin/mailypoppins';
const dmg = `${repo}/releases/latest/download/mailypoppins-desktop-aarch64-apple-darwin.dmg`;
---

{!isLanding && <StarlightHero />}
{isLanding && (
<section class="mp-hero not-content">
  <div class="mp-hero__copy">
    <h1 id="_top" data-page-title set:html={title} />
    {tagline && <p class="mp-hero__tagline" set:html={tagline} />}
    <div class="mp-hero__actions">
      <a class="mp-btn mp-btn--primary" href="/start/install/">
        Get started <Icon name="right-arrow" size="1.1rem" />
      </a>
      <a class="mp-btn" href="/docs/">Docs</a>
      <a class="mp-btn mp-btn--quiet" href={repo}>
        <Icon name="github" size="1.1rem" /> GitHub
      </a>
    </div>
    <ul class="mp-hero__facts">
      <li>CLI, TUI and Mac app</li>
      <li>IMAP, Proton Bridge, Microsoft 365</li>
    </ul>
  </div>

  <div class="mp-install">
    <Tabs syncKey="install">
      <TabItem label="Mac app">
        <p class="mp-install__lead">
          The desktop app for Apple silicon. It carries its own <code>mp</code> and starts the daemon itself.
        </p>
        <a class="mp-btn mp-btn--primary mp-btn--block" href={dmg}>
          <Icon name="download" size="1.1rem" /> Download the DMG
        </a>
        <p class="mp-install__note">
          Not signed yet. Allow it once under Privacy &amp; Security. <a href="/start/install/">Details</a>
        </p>
      </TabItem>
      <TabItem label="Homebrew">
        <p class="mp-install__lead">The <code>mp</code> CLI and terminal UI, on Apple silicon and Linux.</p>
        <Code code={'brew tap sylvainHellin/mailypoppins\nbrew install mailypoppins'} lang="sh" />
      </TabItem>
      <TabItem label="Source">
        <p class="mp-install__lead">Any machine with a Rust toolchain, Intel Macs included.</p>
        <Code
          code={`git clone ${repo}\ncd mailypoppins\ncargo install --path .`}
          lang="sh"
        />
      </TabItem>
    </Tabs>
  </div>
</section>
)}

<style>
  .mp-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: center;
    padding-block: 2.5rem 1rem;
  }

  .mp-hero__copy h1 {
    margin: 0;
    font-size: clamp(2.3rem, 4.2vw, 3.4rem);
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.035em;
    color: var(--sl-color-white);
  }

  .mp-hero__copy h1 :global(em) {
    font-style: normal;
    color: var(--mp-pumpkin-text);
  }

  .mp-hero__tagline {
    margin-top: 1.1rem;
    max-width: 34rem;
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--sl-color-gray-2);
  }

  .mp-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.75rem;
  }

  .mp-hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin: 1.6rem 0 0;
    padding: 0;
    list-style: none;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }

  .mp-hero__facts li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .mp-hero__facts li::before {
    content: '';
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--mp-pumpkin);
  }

  .mp-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.6rem 1.1rem;
    border-radius: 0.55rem;
    border: 1px solid var(--sl-color-hairline-light);
    background: var(--mp-surface);
    color: var(--sl-color-white);
    font-weight: 600;
    font-size: var(--sl-text-sm);
    line-height: 1.2;
    text-decoration: none;
    transition: background-color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
  }

  .mp-btn:hover {
    border-color: var(--sl-color-gray-4);
    background: var(--mp-surface-2);
  }

  .mp-btn--primary {
    background: var(--mp-pumpkin);
    border-color: var(--mp-pumpkin);
    color: var(--mp-on-pumpkin);
  }

  .mp-btn--primary:hover {
    background: color-mix(in srgb, var(--mp-pumpkin) 88%, white);
    border-color: color-mix(in srgb, var(--mp-pumpkin) 88%, white);
  }

  .mp-btn--quiet {
    background: transparent;
  }

  .mp-btn--block {
    display: flex;
    width: 100%;
    padding-block: 0.75rem;
    font-size: var(--sl-text-base);
  }

  .mp-install {
    padding: 0.4rem 1.25rem 1.25rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.9rem;
    background: var(--mp-surface);
    box-shadow: 0 30px 60px -30px rgba(4, 10, 22, 0.45);
  }

  .mp-install :global(starlight-tabs .tablist-wrapper) {
    margin-bottom: 0.25rem;
  }

  .mp-install__lead {
    margin: 1rem 0 0.9rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }

  .mp-install__note {
    margin: 0.8rem 0 0;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  .mp-install__note a {
    color: var(--sl-color-text-accent);
  }

  .mp-install :global(starlight-tabs [role='tabpanel']) {
    min-height: 9.5rem;
  }

  .mp-install :global(.expressive-code) {
    margin: 0;
  }

  @media (max-width: 56rem) {
    .mp-hero {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding-block: 1.25rem 0.5rem;
    }
  }
</style>
