---
import Clients from './Clients.svelte';

interface Props {
  hasDesktopShot: boolean;
}

const { hasDesktopShot } = Astro.props;
---

<section class="hero">
  <div class="hero-intro content-wide">
    <h1 class="hero-headline">
      <span class="hero-maily">maily</span><span class="hero-poppins">poppins</span>
    </h1>
    <p class="hero-tagline">Mail you write in Vim, with your AI agent at your side.</p>
    <p class="hero-description">
      A keyboard-first mail client for macOS and Linux.
      The terminal app, the command line and the Mac app share one local mailbox, so a change in one shows in the others at once.
    </p>
    <div class="hero-cta">
      <a href="#download" class="btn btn-primary">Download</a>
      <a
        href="https://github.com/sylvainHellin/mailypoppins"
        class="btn btn-secondary"
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub
      </a>
    </div>
  </div>

  <div class="hero-clients content-wide">
    <Clients client:load hasDesktopShot={hasDesktopShot} />
  </div>
</section>

<style>
  .hero {
    padding: var(--space-16) 0 var(--space-12);
  }

  .hero-intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    text-align: center;
    max-width: 46rem;
  }

  .hero-headline {
    font-size: 3.25rem;
    letter-spacing: -0.035em;
    line-height: 1;
    margin: 0;
  }

  .hero-maily {
    color: var(--color-text);
  }

  .hero-poppins {
    color: var(--color-frame);
  }

  .hero-tagline {
    font-size: 1.5rem;
    line-height: 1.35;
    font-weight: 500;
    color: var(--color-text);
    margin: 0;
  }

  .hero-description {
    color: var(--color-text-muted);
    margin: 0;
  }

  .hero-cta {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .hero-clients {
    margin-top: var(--space-12);
  }

  @media (max-width: 480px) {
    .hero {
      padding: var(--space-10) 0 var(--space-8);
    }

    .hero-headline {
      font-size: 2.25rem;
    }

    .hero-tagline {
      font-size: 1.25rem;
    }
  }
</style>
