---
// The two reasons to use mailypoppins over an established client.
const pillars = [
  {
    id: 'keyboard',
    title: 'Keyboard-first email client',
    lead: 'Read, triage and write without reaching for the mouse.',
    points: [
      {
        title: 'Write in your editor',
        body: 'Every draft is a Markdown file that opens in Vim, Neovim or any modal editor. The Mac app runs Neovim inside its window.',
      },
      {
        title: 'Vim keys throughout',
        body: 'j and k, gg, / and a Space leader work the same in the terminal and in the Mac app.',
      },
      {
        title: 'Local and offline',
        body: 'Mail from any IMAP provider or Microsoft 365 lands in a local store you can search without a connection.',
      },
    ],
  },
  {
    id: 'agents',
    title: 'Built for efficient human-AI collaboration',
    lead: 'Your agent works with the same commands and files you do, on your Mac or on a Linux server.',
    points: [
      {
        title: 'Context on demand',
        body: 'It searches your mail for a contact or the history of a thread.',
      },
      {
        title: 'A second pair of eyes',
        body: 'It proofreads and reviews your drafts, or writes a first reply when you ask.',
      },
      {
        title: 'Nothing slips',
        body: 'It tells you what you missed and what still waits for your answer.',
      },
    ],
    note: 'A draft leaves only once you mark it approved.',
  },
];
---

<section class="why" aria-label="Why mailypoppins">
  <div class="content-wide">
    {pillars.map((p) => (
      <div class="pillar" id={p.id}>
        <header class="pillar-head">
          <h2>{p.title}</h2>
          <p class="lead">{p.lead}</p>
        </header>
        <ul class="points">
          {p.points.map((pt) => (
            <li>
              <h3>{pt.title}</h3>
              <p>{pt.body}</p>
            </li>
          ))}
        </ul>
        {p.note && <p class="note">{p.note}</p>}
      </div>
    ))}
  </div>
</section>

<style>
  .why {
    padding: var(--space-8) 0 var(--space-16);
  }

  .pillar + .pillar {
    margin-top: var(--space-16);
    padding-top: var(--space-16);
    border-top: 1px solid var(--color-border-subtle);
  }

  .pillar-head {
    max-width: 44rem;
    margin-bottom: var(--space-8);
  }

  .pillar-head h2 {
    margin: 0 0 var(--space-3);
    font-size: 2rem;
  }

  .lead {
    margin: 0;
    font-size: 1.125rem;
    color: var(--color-text-soft);
  }

  .points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8);
  }

  .points li {
    margin: 0;
  }

  .points li::before {
    content: '';
    display: block;
    width: 2rem;
    height: 3px;
    border-radius: 2px;
    background: var(--color-cta);
    margin-bottom: var(--space-4);
  }

  .points h3 {
    margin: 0 0 var(--space-2);
    font-size: 1.0625rem;
  }

  .points p {
    margin: 0;
    color: var(--color-text-soft);
  }

  .note {
    margin: var(--space-8) 0 0;
    font-size: 0.9375rem;
    color: var(--color-text-faint);
  }

  @media (max-width: 768px) {
    .points {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .pillar + .pillar {
      margin-top: var(--space-12);
      padding-top: var(--space-12);
    }

    .pillar-head h2 {
      font-size: 1.5rem;
    }
  }
</style>
