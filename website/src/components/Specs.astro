---
// The technical facts at a glance; the guide and the reference carry the detail.
const specs = [
  {
    term: 'Platforms',
    detail: 'The Mac app runs on Apple silicon. The terminal app and the command line run on macOS (Apple silicon) and Linux (x86_64).',
  },
  {
    term: 'Accounts',
    detail: 'IMAP and SMTP with any provider, Gmail and Proton Mail Bridge included. Microsoft 365 over OAuth2, or the Graph API where a tenant blocks IMAP.',
  },
  {
    term: 'Calendar',
    detail: 'Sends meeting invitations and answers the ones you receive, as standard iMIP messages.',
  },
  {
    term: 'Storage',
    detail: 'Drafts are Markdown files with YAML frontmatter. Received mail sits in a local SQLite store with full-text search, readable offline.',
  },
  {
    term: 'Automation',
    detail: 'JSON output for listing, search and show, IMAP IDLE for new mail, and hooks that run your command when a matching message arrives.',
  },
  {
    term: 'Stack',
    detail: 'Written in Rust, with ratatui for the terminal app and Tauri for the Mac app. MIT licensed.',
  },
];
---

<section class="specs" aria-labelledby="specs-heading">
  <div class="content-wide">
    <h2 id="specs-heading">Technical details</h2>
    <dl class="grid">
      {specs.map((s) => (
        <div class="item">
          <dt>{s.term}</dt>
          <dd>{s.detail}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .specs {
    padding: var(--space-16) 0;
    border-top: 1px solid var(--color-border-subtle);
  }

  .specs h2 {
    margin: 0 0 var(--space-8);
    font-size: 2rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6) var(--space-8);
    margin: 0;
  }

  .item {
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  dt {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-2);
  }

  dd {
    margin: 0;
    color: var(--color-text-soft);
    font-size: 0.9375rem;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .specs h2 {
      font-size: 1.5rem;
    }
  }
</style>
