---
import MobileMenu from './MobileMenu.svelte';

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/getting-started/', label: 'Getting Started' },
  { href: '/commands/', label: 'Commands' },
  { href: '/draft-format/', label: 'Draft Format' },
  { href: '/config/', label: 'Config' },
  { href: '/faq/', label: 'FAQ' },
];

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<nav class="nav">
  <div class="nav-inner content-wide">
    <a href="/" class="nav-logo" aria-label="mailypoppins home">
      <svg width="30" height="30" viewBox="0 0 1024 1024" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <g fill="none" stroke="currentColor" stroke-width="40" stroke-linecap="round" stroke-linejoin="round">
          <path d="M212 480 C 212 300 350 190 512 190 C 674 190 812 300 812 480 a 75 56 0 0 0 -150 0 a 75 56 0 0 0 -150 0 a 75 56 0 0 0 -150 0 a 75 56 0 0 0 -150 0 Z"/>
          <path d="M512 190 V 150"/>
          <path d="M512 480 V 560"/>
          <path d="M512 880 A 62 62 0 0 1 388 870 V 840"/>
          <rect x="232" y="560" width="560" height="320" rx="24"/>
          <path d="M232 584 L512 760 L792 584"/>
        </g>
        <circle cx="512" cy="130" r="30" fill="#FF6700"/>
      </svg>
    </a>

    <div class="nav-links">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={['nav-link', { active: isActive(link.href) }]}
        >
          {link.label}
        </a>
      ))}
    </div>

    <div class="nav-right">
      <a
        href="https://github.com/sylvainhellin/mailypoppins"
        class="nav-github"
        aria-label="GitHub repository"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
        </svg>
      </a>

      <div class="nav-mobile">
        <MobileMenu client:load {currentPath} />
      </div>
    </div>
  </div>
</nav>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--nav-height);
    background: color-mix(in srgb, var(--color-bg-nav) 85%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    height: 100%;
    gap: var(--space-6);
  }

  .nav-logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    color: var(--color-text);
    transition: opacity 0.15s ease;
  }

  .nav-logo:hover {
    opacity: 0.8;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    flex: 1;
  }

  .nav-link {
    padding: var(--space-2) var(--space-3);
    font-size: 0.875rem;
    color: var(--color-subtext0);
    border-radius: 6px;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .nav-link:hover {
    color: var(--color-text);
    background: var(--color-surface0);
  }

  .nav-link.active {
    color: var(--color-mauve);
    background: color-mix(in srgb, var(--color-mauve) 10%, transparent);
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    flex-shrink: 0;
  }

  .nav-github {
    display: flex;
    align-items: center;
    color: var(--color-subtext0);
    transition: color 0.15s ease;
  }

  .nav-github:hover {
    color: var(--color-text);
  }

  .nav-mobile {
    display: none;
  }

  @media (max-width: 768px) {
    .nav-links {
      display: none;
    }

    .nav-mobile {
      display: flex;
    }
  }
</style>
