---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import DocsTabs from '../components/DocsTabs.astro';
import CommandTable from '../components/CommandTable.astro';
import CodeBlock from '../components/CodeBlock.astro';
import KeyBindingTable from '../components/KeyBindingTable.astro';
import { Code } from 'astro:components';
import { codeTheme } from '../styles/code-theme';
// TUI key bindings are GENERATED from the single KEYMAP source of truth in
// clients/tui/src/app/keymap.rs. Do not hand-edit; run scripts/regen-website-keys.sh
// after changing KEYMAP so the site cannot drift from the TUI/help overlay.
import tuiKeys from '../data/tui-keys.json';

const draftCommands = [
  { command: 'mp <selector>', description: 'Preview a draft (dry-run)' },
  { command: 'mp new <name> [-s <name>|--no-signature]', description: 'Create a new draft from template and print its selector' },
  { command: 'mp list [--status draft|approved|sent] [--json]', description: "List the account's drafts (--json prints them as JSON on stdout)" },
  { command: 'mp validate [<selector>]', description: 'Validate one draft, or every draft of the account' },
  { command: 'mp path <selector>', description: 'Print the filesystem path of a draft' },
  { command: 'mp edit <selector>', description: 'Open a draft in $EDITOR' },
  { command: 'mp mark-approved <selector>', description: 'Mark draft as approved' },
  { command: 'mp mark-draft <selector>', description: 'Demote approved draft back to draft' },
  { command: 'mp delete <drafts-selector> [--force]', description: 'Delete a draft (file + index row); --force is required for an approved draft' },
  { command: 'mp delete --sent', description: "Clear every sent draft of the account" },
  { command: 'mp send <selector> [-y]', description: 'Send a single approved email' },
  { command: 'mp send --invite ...', description: 'Send a calendar invitation (iMIP REQUEST)' },
  { command: 'mp send-approved [--all-accounts] [-y]', description: 'Send every approved draft of the account' },
  { command: 'mp outbox list [--json]', description: 'Show queued, retrying, failed and partly delivered submissions (--json prints them as JSON on stdout)' },
  { command: 'mp outbox retry <id>', description: 'Send a failed submission again' },
  { command: 'mp outbox discard <id>', description: 'Drop a submission and release its bytes' },
  { command: 'mp reply <selector> [--all] [--mailbox <name>] [-s <name>|--no-signature]', description: 'Create a reply draft and print its selector' },
  { command: 'mp forward <selector> [--mailbox <name>] [--as-attachment] [-s <name>|--no-signature]', description: 'Create a forward draft and print its selector; --as-attachment attaches the original as an .eml (message/rfc822, quoted thread and attachments inside) instead of carrying its attachments, under a body holding only the signature' },
];

const imapCommands = [
  { command: 'mp sync [options]', description: 'Sync local folders with server' },
  { command: 'mp watch [options]', description: 'Watch mailbox for changes (IMAP IDLE)' },
  { command: 'mp list-mailboxes [--json]', description: 'List every folder on the server with its sync policy (sync, status-only, ignore) and its role, or why it is ignored (--json prints them as JSON on stdout)' },
  { command: 'mp archive <selector> [--mailbox <name>]', description: 'Archive a received email (server + local)' },
  { command: 'mp move <selector> <mailbox> [--mailbox <name>]', description: 'Move a received email to another mailbox (server + local), named by role, slug or label (inbox, Junk, archive); an unknown name lists the account\'s mailboxes, and the mailbox the message is already in is refused' },
  { command: 'mp delete <selector> [--mailbox <name>]', description: 'Delete a received email (server + local), or a local draft with a drafts selector' },
  { command: 'mp search <query> [--json]', description: 'Search emails on the server with one grammar (fields, has:attachment, dates, OR groups); --local searches the store offline; --json prints the hits as JSON on stdout' },
  { command: 'mp open <selector> [--mailbox <name>]', description: 'Open the attachments in the default app; a message whose only parts are inline images opens those' },
  { command: 'mp save <selector> [--output <dir>] [--mailbox <name>]', description: 'Save the attachments and the inline images to a directory, fetching the message from the server first when the store lacks it and the selector names its mailbox' },
  { command: 'mp export <selector> [--output <dir>] [--mailbox <name>]', description: 'Write the raw message (RFC 822, quoted thread included) to <date>_<subject>.eml in a directory, ready to attach to another mail; a message stored without its raw form (every Graph message) is downloaded from the server' },
];

const storeCommands = [
  { command: 'mp list-messages [--mailbox <name>] [-n N] [--json]', description: 'List received messages from the local store (offline; --json prints them as JSON on stdout)' },
  { command: 'mp show <selector> [--mailbox <name>] [--json]', description: 'Print one received message (headers, attachments, inline images and body) from the local store, fetching it from the server first when the store lacks it and the selector names its mailbox' },
  { command: 'mp search --local <query> [--mailbox <name>] [-n N] [--full] [--json]', description: 'Ranked full-text search over the local store (offline, every synced mailbox at once)' },
];

const storeOptions = [
  { command: '--mailbox <name>', description: 'Mailbox to list (role, slug or sidebar label). Default: every mailbox of the account, grouped' },
  { command: '-n, --limit <N>', description: 'Max messages per mailbox listed (default: 20)' },
  { command: '-A, --account <name>', description: 'Account to read (default: first in config)' },
  { command: '--json', description: 'Emit one JSON object instead of the human layout (mp show: the message; mp list-messages and mp search: the listing, with selectors and ISO 8601 dates)' },
];

const maintenanceCommands = [
  { command: 'mp hooks list [--json]', description: 'List the mail hooks of [[accounts.hooks]] with their cursor and last run (every account unless -A names one)' },
  { command: 'mp hooks test <hook> <selector> [--json]', description: "Check a hook against a stored message: each match criterion's verdict, the authenticated sender among them; runs nothing" },
  { command: 'mp hooks replay <hook> <selector>', description: 'Run a hook for a stored message now, in the daemon, behind the same match table; the cursor does not move' },
  { command: 'mp store gc [--dry-run] [--force] [--all-accounts]', description: 'Run the retention sweep now: evict cached blobs over the disk cap. The first over-cap run only warns and records a marker; run it again to evict. --dry-run prints what would go without touching anything; a plan reclaiming more than half the store is refused without --force. The sweep also runs automatically after every sync.' },
  { command: 'mp cutover [-A NAME] [--dry-run]', description: 'End the pre-1.0 file-era layout: give any draft that has none an id: field, and report the old .md mailbox directories nothing reads any more' },
];

const configCommands = [
  { command: 'mp config init', description: 'Interactive setup wizard' },
  { command: 'mp config show', description: 'Display config (passwords masked)' },
  { command: 'mp config set-password', description: 'Store a password in the active secrets backend (first account unless -A names one)' },
  { command: 'mp config reset-secrets', description: 'Wipe the encrypted secrets file and Graph token caches, then re-prompt for credentials (after a restore to a new machine, or when the secrets file no longer decrypts)' },
  { command: 'mp config add-account', description: 'Add a new account to the existing config' },
  { command: 'mp config oauth2-login', description: 'Sign a Microsoft 365 (Graph) account in with the OAuth2 device code flow (first Graph account unless -A names one)' },
  { command: 'mp config path', description: 'Print config file path' },
];

const daemonCommands = [
  { command: 'mp daemon run [--foreground-logs]', description: 'Run the daemon in the foreground; never connects to another daemon' },
  { command: 'mp daemon start [--timeout-secs N]', description: 'Start the daemon (through the login service when one is installed for this data directory, detached otherwise) and return once it answers' },
  { command: 'mp daemon status [--json]', description: 'Report whether a daemon is running against this data directory' },
  { command: 'mp daemon stop [--grace-secs N] [--timeout-secs N]', description: 'Ask the running daemon to shut down, letting work in flight settle for the grace' },
  { command: 'mp daemon restart [--grace-secs N]', description: "Stop the running daemon and start this executable's, through the login service when one is installed, so a systemd unit or launchd agent stays in charge" },
  { command: 'mp daemon install-service [--check] [--force]', description: 'Install the login-start service (systemd user unit or launchd agent) and enable it; --check reports and writes nothing' },
  { command: 'mp daemon uninstall-service', description: 'Disable the login-start service and remove its file' },
  { command: 'mp daemon health [--json]', description: "Report the running daemon's health, its counters and its checks" },
  { command: 'mp daemon logs [--lines N] [--level LEVEL] [--json]', description: "Print the tail of the daemon's own structured log" },
  { command: 'mp daemon support-bundle [OUT] [--no-redact]', description: 'Write a redacted support bundle and say what went into it' },
  { command: 'mp account list', description: 'List the configured accounts, their backend and their state' },
];

const contactsCommands = [
  { command: 'mp contacts search [<query>] [--parsable|--json] [-n N]', description: 'Fuzzy-search the contact index by name and email; --parsable emits tab-delimited email/name lines for mutt, aerc or vim, --json one JSON object with the counts (default limit: 20)' },
  { command: 'mp contacts rebuild', description: 'Rebuild the contact index from the local message store now (every account unless -A names one)' },
  { command: 'mp contacts stats', description: 'Show contact index statistics' },
];

const signatureCommands = [
  { command: 'mp signature list [--json]', description: "List the signatures, the account's default marked" },
  { command: 'mp signature show <name> [--path]', description: "Print a signature's content, or with --path the path of its file" },
  { command: 'mp signature new <name>', description: 'Create an empty signature and print the path of its file' },
  { command: 'mp signature edit <name>', description: 'Open a signature in $EDITOR' },
  { command: 'mp signature rename <old> <new>', description: 'Rename a signature; an account default that named it follows' },
  { command: 'mp signature delete <name>', description: 'Delete a signature, clearing any account default that named it' },
  { command: 'mp signature default [<name>|--none]', description: "Print the account's default signature, set it, or clear it with --none" },
];

const syncOptions = [
  { command: '-n, --limit <N>', description: 'Max messages per mailbox (default: 50)' },
  { command: '--mailbox <name>...', description: 'Mailboxes to sync (default: INBOX, Archive, Sent)' },
  { command: '--dry-run', description: 'Show what would change without modifying files' },
  { command: '--all-accounts', description: 'Sync every configured account (names the failures, exits 1 if any failed)' },
];

const globalOptions = [
  { command: '-A, --account <name>', description: 'Account to use, before or after the command (default: first in config; mp calendar rebuild, mp calendar list, mp calendar view, mp calendar reminders, mp cutover and mp contacts rebuild cover every account unless it names one, and mp calendar view takes it more than once; mp -A <name> with no command opens the TUI on that account). Refused by the commands that act on no account: mp daemon, mp completions, mp dump-keys, mp account list, and mp config init, show, add-account, reset-secrets and path' },
];

const signatureOptions = [
  { command: '-s, --signature <name>', description: 'Use a specific signature (mp new, mp reply, mp forward, and mp send --invite)' },
  { command: '--no-signature', description: 'Skip signature entirely (the same four)' },
];

const calendarCommands = [
  { command: 'mp calendar list [-A NAME] [--json]', description: 'List the calendars with their account, name, id, backend, visibility and colour, the default one marked (every account unless -A names one)' },
  { command: 'mp calendar view [agenda|day|week] [--on DATE | --from DATE --to DATE]', description: 'Show the events: the agenda from --on (default today) through 14 days later or from --from through --to, one day, or the ISO week holding --on. DATE is YYYY-MM-DD, today, tomorrow, yesterday or +N / -N days. -A NAME and --calendar ID (both repeatable) narrow the view, --hidden adds the hidden calendars, --zone reads the times in another IANA zone than the local one, and --json prints the calendar.view answer' },
  { command: 'mp calendar show|hide <calendar-id> [-A NAME]', description: 'Show a hidden calendar in the views again, or hide one; a local preference that survives mp calendar rebuild' },
  { command: 'mp calendar freebusy [-A NAME] [--on DATE | --from DATE --to DATE] [ADDRESS]...', description: 'Show when people and rooms are busy, your own row first: per address a row of 30-minute slots per day (· free, ▒ tentative, █ busy, ▓ away, ░ working elsewhere, ? unknown) and the busy blocks with their times; an address outside your organisation reads "no free/busy". --on is one day (default today), --from through --to up to 61 days, --interval MIN sets the slot length (5 to 1440), --zone ZONE the days\' zone, --json prints the result. Needs a Microsoft 365 account' },
  { command: 'mp event create [-A NAME] --summary TEXT --start WHEN [--end WHEN | --duration D]', description: 'Create an event in the account\'s server calendar, whose server sends the invitations: --to, --optional and --room invite people and rooms, --teams adds a Teams link on a calendar that offers Teams (one whose mailbox has no Teams licence refuses it), --reminder MIN or --no-reminder sets the reminder (the mailbox default otherwise), --location, --body or --body-file, --calendar ID (default the account\'s default calendar), --zone ZONE for the times (default the local zone); a bare date makes an all-day event whose --end is its last day; --transaction-id reruns a create with the id it printed when it could not confirm the event, so the server makes the event once; --repeat daily|weekly|monthly|yearly makes a series, with --every N, --on MO,WE for the days of a weekly series, or the weekday of one monthly by weekday (default the start\'s), --monthly-by weekday for the start\'s weekday in the same week of the month (default its day), and --until DATE or --count N for its end; --json prints the result' },
  { command: 'mp event update <event-id> [-A NAME]', description: 'Change an event: only the fields you name change, and the server sends the attendees an update. --summary, --start, --end or --duration, --all-day, --zone (default the event\'s own), --location or --clear-location, --body, --body-file or --clear-body, --to, --optional and --room (the whole new attendee list), --teams, --reminder MIN or --no-reminder and --show-as; a new --start keeps the event\'s length. --use-proposal ADDR moves the meeting to the time that attendee proposed, as mp event show lists it: on an occurrence of a series that occurrence alone, on a series master the whole series. An attendee may change only --reminder, --no-reminder and --show-as on their own copy. An occurrence of a series needs --scope occurrence (it alone) or --scope series (the whole series, its times read against the first occurrence, a new time or --repeat resetting the occurrences changed on their own); --json prints the result' },
  { command: 'mp event cancel <event-id> [-A NAME] [--scope occurrence|series] [--comment TEXT]', description: 'Cancel a meeting you organize: the server sends every attendee the cancellation, with the comment; on an occurrence of a series --scope names it alone or the whole series; a meeting someone else organizes is declined with mp event respond instead, and one that invites nobody is deleted; --json prints the result' },
  { command: 'mp event delete <event-id> [-A NAME] [--scope occurrence|series]', description: 'Delete an event that tells nobody: one without attendees, or your copy of a meeting its organizer cancelled; on an occurrence of a series --scope names it alone or the whole series; a live meeting is cancelled (organizer) or declined (attendee) instead; --json prints the result' },
  { command: 'mp event show <event-id> [-A NAME] [--json]', description: 'Print one event: when, where, organizer, attendees with their answers and proposed times, your own answer, whether new times are accepted, the series rule (and whether this occurrence was changed), the online meeting and its service, link and description; --json adds the series of an occurrence' },
  { command: 'mp event respond <event-id> accept|tentative|decline [-A NAME]', description: 'Answer an invitation through the server for a server event, or by iMIP reply for an invitation mail (imip:<row_id>); --comment TEXT adds a note, --no-send-response records the answer without telling the organizer (server events only, and without --comment), --propose WHEN with tentative or decline proposes a new time to the organizer (keeping the event\'s length unless --propose-end or --propose-duration names another, read in the event\'s zone, the local one for an all-day event, unless --zone names another; not on an invitation mail), --json prints the result' },
  { command: 'mp invite accept|tentative|decline <selector> [--comment TEXT] [--no-send-response]', description: 'Answer a received invitation mail: through the server when the account has a server calendar holding its event, else by iMIP REPLY' },
  { command: 'mp calendar reminders [-A NAME] [--json]', description: 'List the reminders that fired and wait for you: the summary, when the event starts, where, and the account and event id a dismissal names (every account unless -A names one); --json prints the calendar.reminders answer' },
  { command: 'mp calendar reminder dismiss <event-id> [-A NAME]', description: 'Dismiss an event\'s reminder in every client, and in Outlook on a Microsoft 365 account; a reminder dismissed before it fires does not fire' },
  { command: 'mp calendar reminder snooze <event-id> [--minutes N] [-A NAME]', description: 'Snooze an event\'s reminder for N minutes (default 5) in every client, and in Outlook on a Microsoft 365 account' },
  { command: 'mp calendar rebuild [-A NAME]', description: 'Report the attendee RSVPs resolved against your sent invites, and resync the server calendar of an account that has one (every account unless -A names one)' },
];

const inviteOptions = [
  { command: '--invite', description: 'Send an iMIP calendar invitation (METHOD:REQUEST)' },
  { command: '--to <addr>', description: 'Attendee(s), comma-separated (also the To header)' },
  { command: '--cc <addr>', description: 'CC attendee(s), comma-separated' },
  { command: '--subject <text>', description: 'Event summary (reused as the email subject)' },
  { command: '--start <when>', description: 'Start: local time or RFC3339 with offset; a bare date (2026-12-24) makes an all-day event' },
  { command: '--end <when>', description: 'End, the same kind as --start; for an all-day event the last day, inclusive' },
  { command: '--duration <dur>', description: 'Duration instead of --end: PT1H30M or 1h30m; whole days (P3D, 3d) for an all-day event' },
  { command: '--location <text>', description: 'Optional event location' },
  { command: '--description <text>', description: 'Optional event description / body' },
  { command: '--uid <uid>', description: 'Re-send an invitation already sent, as an update of the event with this UID' },
  { command: '--sequence <n>', description: 'The update\'s SEQUENCE, higher than the last one sent for the UID (needs --uid)' },
];

const localSearchSyntax = [
  { command: 'word', description: 'Matches the whole word in subject, sender or body; several words all have to match' },
  { command: '"a phrase"', description: 'Matches the words adjacent, in that order' },
  { command: 'word*', description: 'Prefix match (invoi* finds invoicing)' },
  { command: 'subject:', description: 'Restrict the term to the subject' },
  { command: 'from:', description: 'Restrict the term to the sender' },
  { command: 'body:', description: 'Restrict the term to the body text' },
  { command: '--mailbox <name>', description: 'Restrict the search to one mailbox (default: the whole account)' },
];

const searchSyntax = [
  { command: 'from:', description: 'Filter by sender' },
  { command: 'to:', description: 'Filter by recipient' },
  { command: 'cc:', description: 'Filter by CC' },
  { command: 'subject:', description: 'Filter by subject' },
  { command: 'body:', description: 'Filter by body content' },
  { command: 'filename:', description: 'Match an attachment filename (Gmail/Exchange/--local only)' },
  { command: 'has:attachment', description: 'Only mail carrying an attachment' },
  { command: 'after:', description: 'On or after this date, YYYY-MM-DD (since: is an alias)' },
  { command: 'before:', description: 'Strictly before this date, YYYY-MM-DD' },
  { command: 'message-id:', description: 'Exact RFC 5322 Message-ID lookup; angle brackets optional' },
  { command: 'in:', description: 'Restrict search to a mailbox' },
  { command: '"a phrase"', description: 'A quoted phrase is one term' },
  { command: '(a OR b)', description: 'An OR group; AND-ed with the rest of the query' },
  { command: 'bare text', description: 'Matches any field' },
];

const searchFlags = [
  { command: '--from / --to / --cc / --subject / --body / --filename <s>', description: 'The field prefixes as flags; they build the same query' },
  { command: '--has-attachment', description: 'Only mail carrying an attachment (has:attachment)' },
  { command: '--after / --before <YYYY-MM-DD>', description: 'The date range as flags' },
  { command: '--mailbox <name>', description: 'Scope to one mailbox by role, label or server name: any folder the server lists (--local: any mailbox of the sidebar)' },
  { command: '-n, --limit <N>', description: 'Max results across every searched mailbox, newest first (default: 20): each mailbox is asked for its newest N, and only the N newest overall are downloaded; a server search cut by it ends with a "raise -n" line; Exchange stops a search at 1000 results per mailbox, so a larger limit there says to narrow the query instead' },
  { command: '--full', description: 'Show full body instead of preview' },
  { command: '--local', description: 'Search the local FTS index offline instead of the server' },
  { command: '--json', description: 'Print the hits as one JSON object on stdout, with "truncated": true when more matched than --limit let through; warnings stay on stderr' },
];

// Slugify a section title for the heading anchor id.
const slug = (title) => title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---

<Layout title="Commands · mailypoppins" description="Complete reference for mailypoppins CLI commands and TUI key bindings.">
  <Nav />
  <main id="main-content" class="content page">
    <DocsTabs />
    <header class="page-header">
      <h1>Commands</h1>
      <p class="subtitle">Complete reference for CLI commands and TUI key bindings.</p>
    </header>

    <section>
      <h2 id="tui">TUI</h2>
      <p>
        Running <code>mp</code> with no arguments launches a full-screen terminal interface
        built on <code>ratatui</code>: a mailbox sidebar, the message list, and the headers and body of the selected message.
        <code>mp -A &lt;account&gt;</code> opens it on that account.
        The sidebar hides below 40 columns and the right panes below 80.
      </p>
      <p>
        Like the CLI and the Mac app, the TUI is a client of the local daemon, which syncs every account and pushes new mail to it.
      </p>
    </section>

    <section>
      <h2 id="selectors">Selectors</h2>
      <p>
        Every command that names a message takes a selector, never a file path:
        <code>mp://&lt;account&gt;/&lt;mailbox&gt;/&lt;key&gt;</code>. For received mail the key is the
        Message-ID without its angle brackets; for a draft the mailbox is the reserved name
        <code>drafts</code> and the key is the <code>id:</code> field in the draft's frontmatter,
        so renaming the file does not change its selector.
      </p>
      <p>
        The leading segments can be left off: the account falls back to <code>-A/--account</code>
        or the first account in your config, and the mailbox to <code>--mailbox</code> or the
        command's own scope. <code>mp send 9f2c1ab30d5e4471</code> and
        <code>mp send mp://work/drafts/9f2c1ab30d5e4471</code> are the same command. A key that
        matches messages in two mailboxes is reported with both full selectors rather than
        resolved by guesswork; <code>--mailbox</code> picks one. When one mailbox holds two
        copies of a message, the refusal lists each with its UID appended,
        <code>mp://&lt;account&gt;/&lt;mailbox&gt;/&lt;key&gt;/&lt;uid&gt;</code>, and that
        selector names the one copy. Every command that creates or
        lists something prints the fully qualified form, which pastes straight into the next
        command, and <code>mp path &lt;selector&gt;</code> is the one way back to a filesystem path.
      </p>
      <p>
        A received selector that names its mailbox works even when no sync stored the message,
        as for a server hit of <code>mp search</code>: <code>show</code>, <code>save</code>,
        <code>open</code>, <code>export</code>, <code>reply</code>, <code>forward</code>,
        <code>archive</code>, <code>move</code>, <code>delete</code> and <code>invite</code> fetch it
        from the server first and say so on stderr. When the store holds the message in another
        mailbox, the reads, replies and forwards use that copy; <code>archive</code>,
        <code>move</code> and <code>delete</code> refuse and
        name its selector, since the Inbox and Sent copies of a message are two messages on the server.
      </p>
      <p>
        On a terminal, <code>mp new</code>, <code>mp edit</code>, <code>mp reply</code>,
        <code>mp forward</code>, <code>mp mark-approved</code> and <code>mp mark-draft</code> print
        <code>&#10003; &lt;selector&gt;</code>, <code>mp archive</code> and <code>mp move</code> print
        the selector they moved the message to under <code>&#10003; archived</code> or
        <code>&#10003; moved</code>, and <code>mp save</code> prints
        <code>&#10003; &lt;path&gt;</code> per file. When stdout is a pipe or a file, each prints
        only the bare selector or path, one per line, so
        <code>sel=$(mp new note) &amp;&amp; mp path "$sel"</code> works as written.
      </p>
    </section>

    <section>
      <h2 id="draft-commands">Draft Commands</h2>
      <CommandTable commands={draftCommands} />
    </section>

    <section>
      <h2 id="imap-commands">IMAP Commands</h2>
      <CommandTable commands={imapCommands} />
    </section>

    <section>
      <h2 id="store-commands">Local Store Commands</h2>
      <p>
        Offline reads over what <code>mp sync</code> already brought down. They open no
        connection: they answer from the per-account store, so they work on a plane and cost
        nothing. The one exception is <code>mp show</code> of a message the store does not hold,
        below.
      </p>
      <CommandTable commands={storeCommands} />
      <CommandTable commands={storeOptions} />
      <p>
        <code>mp list-messages</code> prints one line per message with its full selector, which
        pastes straight into <code>mp show</code>, <code>mp reply</code> or <code>mp archive</code>.
        A mailbox that holds two copies of one message lists each with its UID appended
        (<code>mp://&lt;account&gt;/&lt;mailbox&gt;/&lt;key&gt;/&lt;uid&gt;</code>), so every line
        names its own copy; <code>mp search</code> does the same. With no <code>--mailbox</code> it lists every mailbox of the account, grouped, and the
        limit applies per mailbox so a busy inbox cannot hide the others. The order is the one the
        TUI's flat list shows (<code>tc</code> switches an account to it).
      </p>
      <p>
        <code>mp show</code> takes the same selector grammar as every other message command, so
        the bare Message-ID is enough when it is unambiguous, and an
        <code>mp://&lt;account&gt;/...</code> selector reads that account's store rather than the
        default one. A selector that names its mailbox but no message the store holds, such as a
        sent message <code>mp search</code> found on the server that no sync stored, is
        fetched from the server into the store first, with a note on stderr; <code>mp save</code>
        and <code>mp open</code> do the same. A body the store no longer holds (evicted, or never
        ingested) prints as a note under the headers instead of failing. <code>--json</code> is the parseable form:
        one object with the envelope, the attachment list and the body as a JSON string.
        The body's inline images (a signature logo, a pasted screenshot, a phone photo) print
        under their own <code>Inline images:</code> heading after the attachments, and carry
        <code>"inline": true</code> in the JSON list.
      </p>
      <p>
        <code>mp dump-mailbox --json</code> is a different tool with a similar shape: it is the
        parity oracle, emits newline-delimited envelopes without bodies for every account, and its
        record shape is pinned. Read mail with these two; diff stores with that one.
      </p>
    </section>

    <section>
      <h2 id="maintenance-commands">Maintenance Commands</h2>
      <CommandTable commands={maintenanceCommands} />
      <p>
        Mailypoppins used to keep received mail as one Markdown file per message under
        <code>~/.local/share/mailypoppins/accounts/&lt;account&gt;/</code>. It now keeps it in a
        SQLite store beside a content-addressed blob store, and those old
        <code>inbox/</code>, <code>archive/</code> and <code>sent/</code> directories are dead
        weight. <code>mp cutover</code> is the one-time tidy-up: it lists each dead directory with
        its size and prints the <code>rm</code> line that removes it.
      </p>
      <p>
        It never deletes anything itself, and there is no migration on startup: it runs only
        when you run it. Its one write is the <code>id:</code> frontmatter field, which is how a
        draft written by the old build becomes addressable by selector; running it again writes
        nothing, and <code>--dry-run</code> writes nothing at all. Drafts are the one thing
        whose truth is a local file (the server's Drafts folder holds a mirror of each, not the
        original), and they were never in the old directories to begin with.
      </p>
    </section>

    <section>
      <h2 id="config-commands">Config Commands</h2>
      <CommandTable commands={configCommands} />
    </section>

    <section>
      <h2 id="daemon-commands">Daemon Commands</h2>
      <CommandTable commands={daemonCommands} />
      <p>
        Every command that touches your mail asks a background daemon over a Unix socket, and
        starts one if none is running. These manage it directly; <code>mp daemon *</code> never
        starts a daemon it was only asked to report on.
      </p>
    </section>

    <section>
      <h2 id="shell-completions">Shell Completions</h2>
      <p>
        <code>mp completions &lt;bash|zsh|fish|elvish|powershell&gt;</code> prints a completion
        script for every command and flag on stdout. It reads no config and needs no daemon.
      </p>
      <Code code={`# zsh: save it on your fpath, then restart the shell
mp completions zsh > "\${fpath[1]}/_mp"

# bash: load it in ~/.bashrc
eval "$(mp completions bash)"`} lang="sh" theme={codeTheme} />
    </section>

    <section>
      <h2 id="contacts-commands">Contacts Commands</h2>
      <CommandTable commands={contactsCommands} />
      <p>
        The contact index is a cache per account, <code>contacts-cache.json</code> in the
        account's data directory, ranked from the From, To, Cc and Bcc headers of the stored mail.
        Every sync and every send folds the mail it saw into it.
        The first search or stats of an account, from the CLI, the TUI or the desktop app, builds it
        before answering, and rebuilds it first when another version of mailypoppins built it, so a
        reinstall never keeps an index the current rules would not produce.
        <code>mp contacts rebuild</code> rebuilds it on demand.
      </p>
    </section>

    <section>
      <h2 id="signature-commands">Signature Commands</h2>
      <CommandTable commands={signatureCommands} />
      <p>
        A signature is one Markdown file under the configuration directory, and each account
        has its own default; <code>-A</code> names the account. The TUI's <code>cs</code> overlay
        and the Mac app's Signatures dialog manage the same files through the same daemon calls.
      </p>
    </section>

    <section>
      <h2 id="sync-options">Sync Options</h2>
      <CommandTable commands={syncOptions} />
      <p>
        Sync is additive by default: it fetches new emails only, deduplicated by Message-ID.
        A two-pass strategy first downloads headers (~50 bytes per message) to identify new emails,
        then fetches full RFC822 bodies only for messages not already stored locally.
      </p>
      <p>
        Deletes are handled by the same pass. The download is capped by <code>--limit</code>,
        the enumeration never is, so a message the server no longer lists is pruned from the
        local store however far it sits below the newest ones, and a mailbox emptied elsewhere
        does not linger.
      </p>
    </section>

    <section>
      <h2 id="invite-options">Invite Options (<code>mp send --invite</code>)</h2>
      <p>
        <code>mp send --invite</code> sends an iMIP calendar invitation
        (<code>METHOD:REQUEST</code>) over SMTP that renders as an actionable
        Accept / Tentative / Decline event in Outlook, Gmail, and Apple Mail.
        Attendees come from <code>--to</code>/<code>--cc</code> and the subject
        is reused as the event summary. Times accept local wall-clock
        (<code>2026-07-20T14:00</code>, <code>"2026-07-20 14:00"</code>) or
        RFC3339 with an offset (<code>2026-07-20T14:00:00+02:00</code>,
        <code>...Z</code>); a timed event needs either <code>--end</code> or
        <code>--duration</code>. The <code>ORGANIZER</code> is the sending
        account's primary address (Exchange drops mismatches). Graph accounts
        are not yet supported for invites.
      </p>
      <p>
        A bare date as <code>--start</code> sends an all-day event, which
        calendars show in the all-day row. Without <code>--end</code> it covers
        that one day. <code>--end</code> names the last day, inclusive, so
        <code>--start 2026-12-24 --end 2027-01-08</code> covers 24 December
        through 8 January; the invitation carries the day after as its
        exclusive <code>DTEND</code>, as RFC 5545 requires.
      </p>
      <p>
        To change an invitation already sent, send it again with
        <code>--uid</code> set to its <code>UID</code> (shown in the preview
        and in its <code>invite.ics</code>) and a higher <code>--sequence</code>
        (the first send is 0, so the first update is 1). Calendar clients
        replace the event only when the UID matches and the sequence is higher
        than the one they hold; without <code>--uid</code> the invitation is a
        new event.
      </p>
      <CodeBlock
        lang="bash"
        code={`mp send --invite --to me@example.com --subject "Kita closed" --start 2026-12-24
mp send --invite --to me@example.com --subject "Christmas holidays" --start 2026-12-24 --end 2027-01-08
mp send --invite --to me@example.com --subject "Kita closed" --start 2026-12-24 \\
  --uid 3f2a...@example.com --sequence 1`}
      />
      <CommandTable commands={inviteOptions} />
    </section>

    <section>
      <h2 id="calendar-commands">Calendar Commands (<code>mp calendar</code>, <code>mp event</code>)</h2>
      <p>
        The calendar views merge two sources: the server calendar of an account
        whose <code>calendar_backend</code> is <code>graph</code>, which the
        daemon keeps a month back and a year ahead, and the invitation mails of
        every account, listed as its <code>imip</code> calendar. An invitation
        the server calendar also holds shows once, as the server's event.
        Each event line in a view carries your answer: <code>✓</code> accepted,
        <code>~</code> tentative, <code>✗</code> declined, <code>?</code> not
        answered, <code>★</code> organizer. The event ids that
        <code>mp event</code> takes are in <code>mp calendar view --json</code>.
      </p>
      <CommandTable commands={calendarCommands} />
      <CodeBlock
        code={`mp calendar view
mp calendar view week --on +7 -A evoqs
mp calendar hide AAMkADcal2 -A evoqs
mp calendar freebusy -A evoqs --on tomorrow ada@example.com room-1@example.com
mp event create -A evoqs --summary "Project review" --start 2026-11-18T14:00 --duration 1h --to ada@example.com --teams
mp event create -A evoqs --summary Standup --start 2026-11-23T09:00 --duration 15m --repeat weekly --on MO,WE,FR --until 2026-12-18
mp event update AAMkADev1 --start 2026-11-18T15:00 -A evoqs
mp event update AAMkADocc2 --scope series --summary "Standup, new room" -A evoqs
mp event cancel AAMkADev1 --comment "Postponed to next month" -A evoqs
mp event respond AAMkADev2 accept --comment "See you there" -A evoqs
mp event respond AAMkADev3 tentative --propose 2026-11-18T16:00 --comment "Could we move it?" -A evoqs
mp event update AAMkADev1 --use-proposal ada@example.com -A evoqs`}
      />
      <p>
        In the TUI, the Calendar view (<code>Space a</code>) shows the same
        events of every account. <code>a</code>, <code>d</code> and
        <code>w</code> switch between the agenda, a day on an hour grid and the
        week in seven columns, which falls back to the day grid on a narrow
        terminal. <code>h</code> and <code>l</code> (or <code>[</code> and
        <code>]</code>) move by a day or a week, <code>t</code> goes back to
        today and <code>gt</code> jumps to a date. <code>Enter</code> opens the
        event card, <code>V</code> answers an invitation (on a tentative or a
        decline, its Propose and Until rows propose a new time to the
        organizer), <code>p</code> on the card of a meeting you organize opens
        the event form at an attendee's proposed time (<code>Tab</code> picks
        the next proposal), so <code>Enter</code> moves the meeting there and
        tells everyone, <code>n</code> opens
        the event form on the cursor's day (Tab moves between its fields,
        <code>Enter</code> on the description opens <code>$EDITOR</code>, and
        <code>Enter</code> anywhere else creates the event), <code>E</code>
        opens the same form on the event under the cursor and sends only what
        you change (on someone else's meeting only the reminder and the show
        as, which <code>Left</code> and <code>Right</code> pick, as they pick
        the calendar),
        <code>D</code> cancels a meeting you organize, with a comment for its
        attendees, or deletes an event that tells nobody. The form's Repeats
        row (<code>Left</code> and <code>Right</code>) makes a series, daily,
        weekly, monthly on the day or the weekday, or yearly, with Every, On
        and Ends under it and the rule in words; <code>E</code> and
        <code>D</code> on an occurrence first ask whether the change is to
        this occurrence (<code>o</code>) or the whole series (<code>s</code>),
        as the desktop app's dialog does. <code>c</code>
        lists the calendars, where <code>Space</code> shows or hides one. A
        create that fails brings the form back as it was, and <code>Enter</code>
        retries it without making a second event. On a Microsoft 365 account
        the form shows your availability and the attendees' and rooms' on the
        event's day: one row each of 30-minute slots from 07:00 to 20:00, the
        chosen time marked, and on <code>E</code> the time the event holds now
        in its own colour, so your busy block there reads as the event. It asks again half a second after you stop typing
        an address or the date; the desktop app's event form shows the
        same as a coloured grid. A
        Graph account whose sign-in predates the calendar shows a banner over the
        view asking for <code>mp config oauth2-login -A &lt;name&gt;</code>,
        which leaves once the new sign-in lands.
      </p>
    </section>

    <section>
      <h2 id="reminders">Reminders (<code>mp calendar reminders</code>)</h2>
      <p>
        The daemon fires each server event's reminder at its due minute, the
        start minus the event's reminder setting in Outlook. A cancelled or
        declined event, one without a reminder and one in a hidden calendar
        never remind; a reminder that fell due while the daemon was stopped
        fires once when it starts, if its meeting has not ended. Only an
        account with a server calendar reminds, since an invitation mail
        carries no reminder setting of its own.
      </p>
      <p>
        One client raises the system notification: the desktop app when it is
        open, else the TUI when <code>notifications = true</code>. Every open
        client shows the reminder in its own window, and a dismissal or a
        snooze in any of them clears or moves it in all of them. On a Microsoft
        365 account the dismissal or the snooze reaches Outlook too, so your
        phone stops reminding of the same meeting; a meeting whose reminder you
        dismiss in Outlook leaves mp's list at the next sync.
      </p>
      <CodeBlock
        code={`mp calendar reminders
mp calendar reminder snooze AAMkADev2 --minutes 10 -A evoqs
mp calendar reminder dismiss AAMkADev2 -A evoqs`}
      />
      <p>
        In the TUI the hint bar counts the waiting reminders, a reminder that
        fires shows on the status line, and <code>R</code> from any view lists
        them: <code>s</code> snoozes the one under the cursor for five minutes,
        <code>d</code> dismisses it and <code>Enter</code> opens its event in
        the Calendar view. In the desktop app a banner over the window lists
        them with Snooze and Dismiss, and a click on the notification brings
        the window forward on the event.
      </p>
    </section>

    <section>
      <h2 id="rsvp">RSVP to Invitations (<code>mp invite</code>)</h2>
      <p>
        <code>mp invite accept|tentative|decline &lt;selector&gt;</code> answers
        a received calendar invitation mail. On an account whose server calendar
        holds the invitation's event, the answer goes through the server, as
        Outlook would send it, and <code>--no-send-response</code> records it
        without telling the organizer, and so takes no <code>--comment</code>. Otherwise it reads the invite email's sidecar
        <code>invite.ics</code> (the source of truth for <code>UID</code>/<code>SEQUENCE</code>),
        builds a <code>METHOD:REPLY</code> with your account as the single
        <code>ATTENDEE</code> carrying the chosen <code>PARTSTAT</code>
        (<code>ACCEPTED</code>/<code>TENTATIVE</code>/<code>DECLINED</code>), and
        emails it to the <code>ORGANIZER</code> with an Outlook-convention
        subject (<code>Accepted: &lt;summary&gt;</code>, etc.). On a successful
        send the local <code>event.rsvp</code> is updated. <code>--comment</code>
        adds a note to either answer. v1 answers the whole series only (no
        per-occurrence responses).
      </p>
      <p>
        In the TUI, invites show a calendar badge in the list and an event
        summary card at the top of the preview pane; press <code>tv</code> to open
        the respond overlay: Accept / Tentative / Decline, an optional comment,
        and, when the account's server calendar holds the event, whether to send
        the response. It answers the way <code>mp invite</code> does.
        <strong>An iMIP reply is emailed to the organizer only: it does not
        reach a server calendar.</strong> A Graph account answers only through
        its server calendar, so it needs <code>calendar_backend = "graph"</code>.
      </p>
      <p>
        A reply sent from a Proton account is not recorded by Exchange and
        Microsoft 365 organizers, because Proton turns its calendar part into an
        attachment on the way out. Answer such an invitation from another
        account or from Proton's own client.
      </p>
    </section>

    <section>
      <h2 id="calendar-rebuild">Organizer RSVP Tracking (<code>mp calendar rebuild</code>)</h2>
      <p>
        When someone accepts or declines an invitation you sent with
        <code>mp send --invite</code>, their reply arrives as a
        <code>METHOD:REPLY</code> email during normal sync. mailypoppins matches
        it by event <code>UID</code> to your sent invitation and shows that
        attendee's <code>status</code> on the invite, so you can see who
        responded. The statuses are computed from the stored invitation and
        reply messages every time they are shown, so the agenda and the preview
        card are always current with what has arrived.
      </p>
      <p>
        <code>mp calendar rebuild [-A NAME]</code> reports what those
        replies resolve across every stored invitation (defaults to all
        accounts). It writes nothing: there is no cached copy of the statuses to
        rebuild, so it is idempotent by construction, and two machines syncing
        the same account see identical state with no direct machine-to-machine
        sync. Replies for a <code>SEQUENCE</code> older than the invitation's are
        ignored, and the most recent reply per attendee wins.
        <strong>Nothing is written back to the server.</strong> On an account
        with a server calendar it also drops the daemon's copy of that calendar
        and reads it afresh, keeping which calendars are hidden, and reports the
        calendars and events it read.
      </p>
    </section>

    <section>
      <h2 id="global-options">Global Options</h2>
      <CommandTable commands={globalOptions} />
      <h3 id="signature-options">Signature Options</h3>
      <p>
        The commands that write a signature into a draft, and <code>mp send --invite</code>,
        whose invitation carries one, take these two after the command name.
      </p>
      <CommandTable commands={signatureOptions} />
    </section>

    <section>
      <h2 id="search-syntax">Search Query Syntax</h2>
      <p>
        The <code>mp search</code> command, its <code>--local</code> mode and the TUI
        server search overlay (<code>f</code>) all speak <strong>one grammar</strong>.
        Fields AND together, <code>(a OR b)</code> groups an alternation, and quoted
        values are supported (e.g., <code>from:"John Doe"</code>). Sylvain's example
        <code>from:boss@corp.com (invoice OR receipt) has:attachment</code> runs on
        every backend. Without an <code>in:</code> prefix or <code>--mailbox</code>, all
        the account's mailboxes are searched, and on Exchange every folder, each hit
        listed under the folder it sits in. A malformed query is an error with a
        caret pointing at the problem, never a silent search for less.
      </p>
      <p>
        The daemon runs every server search, and <code>mp search</code>, the TUI
        overlay and the desktop app's search bar make the same call. A mailbox the
        server refuses does not stop the others: <code>mp search</code> prints
        <code>Search in &lt;mailbox&gt; failed</code> on stderr after the results,
        and the same line names any hit the server matched but did not hand over.
        When more matched than are shown, <code>mp search</code> ends with
        <code>More results than the 20 shown: raise -n to see them.</code>, and the
        TUI and the desktop app end their count with the same sentence and a
        narrower search as the remedy.
      </p>
      <CommandTable commands={searchSyntax} />

      <h3 id="search-flags">Flags (same query, for scripting)</h3>
      <p>
        Every field has a matching flag; a flag invocation builds the identical
        query as its positional twin, so
        <code>mp search --from boss@corp.com --has-attachment 'invoice OR receipt'</code>
        equals <code>mp search 'from:boss@corp.com (invoice OR receipt) has:attachment'</code>.
      </p>
      <CommandTable commands={searchFlags} />

      <h3 id="search-attachment-honesty">has:attachment across backends</h3>
      <p>
        On Gmail and Microsoft Exchange <code>has:attachment</code> runs server-side.
        Plain IMAP (RFC 3501) has <em>no</em> attachment search key, so <code>mp</code>
        answers that part from the local store's synced mail and prints a warning that
        un-synced mail is not covered; run <code>mp sync</code> for full coverage.
        The result header on stdout repeats it, as in
        <code>Fetched Emails (3 results, local store only: has:attachment)</code> or
        <code>No results found (local store only: has:attachment)</code>, so a
        script that drops stderr still sees it, and <code>--json</code> carries
        <code>"coverage": "local"</code> with the term in <code>local_terms</code>
        (<code>"coverage": "server"</code> when the server answered every term).
        The TUI's server search overlay and the desktop app's search bar put the
        same caveat after their count, as in
        <code>2 results (local store only: has:attachment)</code>.
      </p>

      <h3 id="local-search-syntax">Local full-text search (<code>--local</code>)</h3>
      <p>
        <code>mp search --local &lt;query&gt;</code> answers from the local store's
        FTS5 index instead of the server: offline, ranked best match first, and
        covering every synced mailbox of the account at once. A subject hit
        outranks the same word buried in a quoted reply. The index is written in
        the same transaction as the message it describes, so it is never stale
        with respect to what <code>mp sync</code> has pulled, and it holds only
        what has been synced, which is what the server-side search is still for.
        Punctuation is searched as text, not as query syntax.
      </p>
      <CommandTable commands={localSearchSyntax} />
    </section>

    <section>
      <h2 id="tui-keys">TUI Key Bindings</h2>
      <p>
        Generated from the single <code>KEYMAP</code> source of truth
        (<code>clients/tui/src/app/keymap.rs</code>) via <code>mp dump-keys --json</code>;
        see <code>scripts/regen-website-keys.sh</code>. These match the in-TUI
        help overlay (<kbd>?</kbd>) exactly.
      </p>
      <p>
        The copy keys (<kbd>y</kbd>, and <kbd>c</kbd> in Contacts) write to the system
        clipboard. Over ssh the remote host usually has none, so the TUI sends the text to
        your terminal as an OSC 52 escape sequence instead. Ghostty, WezTerm, kitty, iTerm2
        and tmux with <code>set-clipboard on</code> put it on your local clipboard. The
        status line then shows the copied text, so you can still select it by hand in a
        terminal that ignores OSC 52.
      </p>

      {tuiKeys.map((section) => (
        <>
          <h3 id={`${slug(section.title)}-keys`}>{section.title}</h3>
          <KeyBindingTable bindings={section.bindings} />
        </>
      ))}
    </section>
  </main>
  <Footer />
</Layout>

