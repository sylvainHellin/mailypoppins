---
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Why from '../components/Why.astro';
import Download from '../components/Download.astro';
import Specs from '../components/Specs.astro';

// The Mac app tab shows once its screenshot is in public/.
const hasDesktopShot = existsSync(fileURLToPath(new URL('../../public/desktop-screenshot.png', import.meta.url)));
---

<Layout title="mailypoppins · Mail you write in Vim, with your agent at your side">
  <Nav />
  <main id="main-content">
    <Hero hasDesktopShot={hasDesktopShot} />
    <Why />
    <Specs />

    <Download />
  </main>
  <Footer />
</Layout>
