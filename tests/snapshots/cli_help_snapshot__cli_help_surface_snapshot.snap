  -n, --limit <LIMIT>      Max number of results [default: 20]
  -A, --account <ACCOUNT>  Account to use
      --profile <NAME>     Profile to run on, with its own config, data and daemon (default: $MAILYPOPPINS_PROFILE, else the default profile)
  -h, --help               Print help

