{
  "name": "mailypoppins-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "prebuild": "node scripts/gen-keymap.ts --if-bin",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:keymap": "node scripts/gen-keymap.ts",
    "gen:types": "cd ../.. && cargo test -p mp-protocol --features ts --test ts_bindings -- --ignored export_bindings && cd clients/desktop/src-tauri && cargo test --lib ts_bindings::export_bindings -- --ignored",
    "contrast": "node scripts/contrast.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tauri-apps/api": "^2.12",
    "@tauri-apps/plugin-opener": "^2.6",
    "@tauri-apps/plugin-shell": "^2.4.0",
    "@xterm/addon-clipboard": "0.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.49.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.2"
  }
}
